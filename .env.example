# Local: use the logged-in Codex CLI for Vietnamese transcript extraction.
AI_PROVIDER=codex
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex

# Copy these values from the Lark Developer Console / your existing local
# configuration. Do not commit real secrets.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_DOMAIN=https://open.larksuite.com
OAUTH_REDIRECT_URI=https://young-sloths-talk.loca.lt/oauth/callback

# Set AI_PROVIDER=gemini only when running the hosted Gemini provider.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
